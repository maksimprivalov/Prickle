# Copy to .env and fill in. Only the LLM key is required (judge mode).

# Gemini API key, free from https://aistudio.google.com (Get API key).
GEMINI_API_KEY=

# Optional. More Gemini keys, each from a DIFFERENT Google project (free quotas are per project,
# so two keys of one project share one quota). Each agent loop stays on one key.
# GEMINI_API_KEY_2=

# Optional. Models (Mozaik's supported names). The reviewer runs on its own model so it uses
# that model's free quota (gemini-3.5-flash: 5/min, 20/day) instead of flash-lite's (15/min).
# Default: the reviewer uses MODEL_STRONG. Worth setting for a demo or two a day, not for evals.
# MODEL_FAST=gemini-3.5-flash-lite
# MODEL_STRONG=gemini-3.5-flash-lite
# MODEL_REVIEWER=gemini-3.5-flash

# Optional. Gemini requests per minute, per model and per key. Unset: just under each model's
# free-tier limit (14 for flash-lite, 4 for flash). A number: that for every model. 0 = no limit.
# GEMINI_REQUESTS_PER_MINUTE=

# Optional. Seconds an agent loop may take before it fails. Default 360 (free-tier waits).
LOOP_TIMEOUT_SECONDS=360

# mock (default, judge mode) | devnet (real devnet USDC transfer, opt-in)
PAYMENTS=mock

# Used only when PAYMENTS=devnet. Devnet or localhost only; anything else is refused.
SOLANA_RPC_URL=https://api.devnet.solana.com

# Session server port (the frontend proxies /api here).
PORT=8787
