{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(node --version)",
      "Bash(pnpm --version)",
      "Bash(pnpm install --frozen-lockfile*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm test*)",
      "Bash(pnpm check*)",
      "Bash(pnpm demo*)",
      "Bash(pnpm eval*)",
      "Bash(pnpm gen:data*)",
      "Bash(pnpm exec vitest *)",
      "Bash(pnpm exec tsc *)",
      "Bash(pnpm exec eslint *)",
      "Bash(pnpm exec prettier *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git ls-files*)",
      "Bash(git blame*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "PowerShell(node --version)",
      "PowerShell(pnpm --version)",
      "PowerShell(pnpm install --frozen-lockfile*)",
      "PowerShell(pnpm typecheck*)",
      "PowerShell(pnpm lint*)",
      "PowerShell(pnpm test*)",
      "PowerShell(pnpm check*)",
      "PowerShell(pnpm demo*)",
      "PowerShell(pnpm eval*)",
      "PowerShell(pnpm gen:data*)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git show*)",
      "PowerShell(git branch*)",
      "PowerShell(git ls-files*)",
      "PowerShell(git blame*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(.env.devnet)",
      "Read(.wallet/**)",
      "Read(**/*keypair*.json)",
      "Read(**/id.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-protected-files.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-commands.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-edited-ts.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
